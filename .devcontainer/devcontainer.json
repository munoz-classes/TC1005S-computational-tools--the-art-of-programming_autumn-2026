{
    "name": "Entorno Semana Tec - Herramientas Computacionales",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": true
            },
            "extensions": [
                "wokwi.wokwi-vscode",
                "ms-vscode.cpptools",
                "eamodio.gitlens",
                "mads-hartmann.bash-ide-vscode",
                "yzhang.markdown-all-in-one"
            ]
        }
    },
    "remoteUser": "estudiante",
    "postCreateCommand": "echo '¡Sistema en línea! Escribe ./control_mision.sh para iniciar' > /workspaces/${localWorkspaceFolderBasename}/README_ALUMNOS.txt"
}